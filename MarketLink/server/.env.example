# ---- Server ----
PORT=5000
NODE_ENV=development
# Allowed origin of the React dev server (only needed in development)
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local MongoDB (Compass / mongod) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/marketlink

# ---- Auth ----
# Change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Currency symbol used in e-mails, notifications and the assistant
CURRENCY=Rs

# Time zone of the markets (pickup slots and cut-off times use it)
TZ=Asia/Karachi

# ---- E-mail (Nodemailer SMTP) ----
# Order confirmations, "ready for pickup" notices, approvals and password reset links.
#  - Everything empty: e-mails are printed in this server's console (nothing is sent).
#  - SMTP_HOST=ethereal: free test inbox, a link to view every e-mail is printed.
#  - SMTP_USER + SMTP_PASS filled in and SMTP_HOST empty: the server is chosen from the address
#    (gmail.com -> smtp.gmail.com, outlook/hotmail -> smtp-mail.outlook.com, yahoo, icloud, zoho ...).
#  - Real e-mails with Gmail:
#      1. Turn on 2-Step Verification for the Gmail account.
#      2. Google Account > Security > App passwords > create one for "MarketLink".
#      3. Fill in:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=your@gmail.com
#                   SMTP_PASS=the 16-letter app password (spaces are fine)
#      4. Check it:  npm run mail:test -- you@example.com
#  - Other providers (Outlook, Zoho, Brevo, Mailtrap...): use their SMTP host, port and login.
# SMTP_PORT 587 = STARTTLS, 465 = SSL. SMTP_SECURE=true/false overrides the automatic choice.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown to customers, e.g.  MarketLink <your@gmail.com>  (SMTP_FROM works too).
# Leave empty to use SMTP_USER (Gmail only sends from your own address).
MAIL_FROM=
# Address of the website, used for the buttons in e-mails (your Render URL when hosted)
APP_URL=http://localhost:5000

# ---- Cache (optional) ----
# Redis keeps the public pages (categories, markets, farmers, products, FAQs ...) and the admin reports
# ready for a minute, so they load faster. Leave empty to cache in the server's memory instead.
# e.g. redis://127.0.0.1:6379  or the "Internal URL" of a Render Key Value instance
REDIS_URL=

# ---- AI product descriptions (optional) ----
# "Write with AI" in the product form works without a key (built-in writer).
# With an Anthropic API key the descriptions are written by Claude instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
